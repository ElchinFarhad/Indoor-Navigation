{
  "name": "indoor-navigation-client",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "start": "node scripts/venues.js build && vite",
    "build": "node scripts/venues.js build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:e2e": "node e2e/navigation.e2e.js",
    "build:wasm": "sh ../wasm/BUILD",
    "markers": "node scripts/generate-markers.js",
    "venues": "node scripts/venues.js build",
    "venues:check": "node scripts/venues.js check"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.4",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "three": "0.149.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.149.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.0.0",
    "jsdom": "^31.0.0",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
